<?xml version="1.0" encoding="utf-8"?>
<!-- Glance にはアニメーションが無いので、ウィジェットでも自動で動く ViewFlipper でコマを送る -->
<!-- Glance の Row の上下中央揃えがこの中までは効かず上に寄るので、行の高さ (残量の文字の 1 行ぶん) にして中で中央に置く -->
<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="19dp"
    android:autoStart="true"
    android:flipInterval="200">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:scaleType="center"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_flow_in_0" />
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:scaleType="center"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_flow_in_1" />
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:scaleType="center"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_flow_in_2" />
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:scaleType="center"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_flow_in_3" />
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:scaleType="center"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_flow_in_4" />
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:scaleType="center"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_flow_in_5" />
</ViewFlipper>
