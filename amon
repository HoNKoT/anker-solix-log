#!/bin/bash
# amon — Anker Monitor の操作コマンド (gqm に倣った構成)
#
#   amon setup        初回: venv 作成 → 部品導入 (requirements.txt) → アプリ作成 → 起動
#   amon deploy|up|r  このフォルダの変更を反映して再起動 (Swift/Python どちらを変えても)
#   amon start|stop|restart   (restart は再ビルドしない。変更を反映するなら deploy)
#   amon status       稼働状況と現在値
#   amon open         ダッシュボードをブラウザで開く
#   amon logs         バックエンドのログを流す
#   amon run [args]   バックエンドを前面で動かす (デバッグ用: amon run --debug)
#   amon demo         ダミー値で動かす (画面確認用。先に amon stop)
#   amon autostart on|off   ログイン時に自動起動
#   amon lan on|off   スマホなど同じ Wi-Fi の端末から見られるようにする (見るだけ。URL を表示)
#   amon token [new|off]  このMac以外から読むときのトークン (表示 / 作り直し / やめる)
#   amon remote <URL> <トークン>  (見る側の Mac で) 記録している Mac をメニューバーで見る。off で戻す
#   amon remote local|global <URL>  ローカル (名前.local) とグローバル (…ts.net) を別々に覚える。ローカル優先で接続
#   amon remote token <トークン>     トークンだけ変える (メニューの「接続先…」からも設定できます)
#   amon url          この Mac を開くアドレス (localhost / 名前.local / Tailscale の名前 / IP)。deploy の最後にも出る
#   amon env          どこからでも amon と打てるようにする PATH の行を出す (amon env >> ~/.zshrc)
#   amon get <パス>   API を読んで JSON を出す (リモート表示中なら記録している Mac から、トークン付きで)
#                     例: amon get '/api/raw?hours=48'  /api/raw?dev=<id>&from=<UNIX秒>&to=<UNIX秒>
#   amon cloud-setup  クラウド(Wi-Fi経由)で読む部品を入れる (Python 3.12 以上が必要。足りなければ環境を作り直す)
#   amon scan-all    周りのBluetooth機器を全部表示 (機種が見つからないとき用。先に amon stop)
#   amon link         どこからでも amon で呼べるようにする (PATH 上にリンク作成)

set -u

# このスクリプトの本当の場所 (シンボリックリンクをたどる)
SELF="$0"
while [ -L "$SELF" ]; do
  T="$(readlink "$SELF")"
  case "$T" in /*) SELF="$T" ;; *) SELF="$(dirname "$SELF")/$T" ;; esac
done
SRC_DIR="$(cd "$(dirname "$SELF")" && pwd)"

APP="$HOME/Applications/AnkerMonitor.app"
APP_BIN="$APP/Contents/MacOS/AnkerMonitor"
DATA="$HOME/.anker-monitor"
VENV="$DATA/venv"
PY_DST="$DATA/anker_monitor.py"
PORT=19877
LABEL="dev.amon.anker-monitor"
AGENT="$HOME/Library/LaunchAgents/$LABEL.plist"
TOKEN_FILE="$DATA/api_token"
REMOTE_FILE="$DATA/remote.json"

# ~/Documents 配下だとアプリが読むたびに権限を聞かれるので、実行用のコピーは ~/.anker-monitor に置く

say()  { printf '\033[1m▶ %s\033[0m\n' "$*"; }
ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$*"; }
err()  { printf '  \033[31m✗\033[0m %s\n' "$*" >&2; }

find_python() {
  local c min="${1:-12}"
  for c in python3.14 python3.13 python3.12 python3.11 \
           /opt/homebrew/bin/python3.13 /opt/homebrew/bin/python3.12 /opt/homebrew/bin/python3 \
           /usr/local/bin/python3 python3; do
    if command -v "$c" >/dev/null 2>&1 &&
       "$c" -c "import sys; sys.exit(0 if sys.version_info >= (3, $min) else 1)" 2>/dev/null; then
      command -v "$c"; return 0
    fi
  done
  return 1
}

backend_up() { curl -fsS --max-time 2 "http://localhost:$PORT/status" >/dev/null 2>&1; }
is_remote() { [ -f "$REMOTE_FILE" ]; }
remote_get() {  # remote.json の項目 (local / global / token) を読む
  /usr/bin/python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2]) or "")' "$REMOTE_FILE" "$1" 2>/dev/null
}
norm_url() {  # 名前 / 名前:ポート / http://… を http://名前:ポート にそろえる
  local u="$1"
  [ -n "$u" ] || return 0
  case "$u" in http://*|https://*) ;; *) u="http://$u" ;; esac
  u="${u%/}"
  case "${u#*://}" in *:*) ;; *) u="$u:$PORT" ;; esac
  echo "$u"
}
remote_urls() {  # 接続先の候補を ローカル → グローバル の順に (url は 1 つだけ持っていた頃の形)
  local l g; l="$(remote_get local)"; g="$(remote_get global)"
  if [ -n "$l$g" ]; then [ -n "$l" ] && echo "$l"; [ -n "$g" ] && echo "$g"; else remote_get url; fi
}
# いま届く接続先を 1 つ選ぶ。ローカルは届かないときにすぐ諦められるよう 2 秒だけ待つ
# (401/403 も「届いた」に数える: トークン違いはグローバルに回しても直らないため)
remote_pick() {
  local u first="" tok code; tok="$(remote_get token)"
  for u in $(remote_urls); do
    [ -n "$first" ] || first="$u"
    code="$(printf 'header = "Authorization: Bearer %s"\n' "$tok" | curl -s -o /dev/null -w '%{http_code}' \
      --max-time "$([ "$u" = "$first" ] && echo 2 || echo 5)" -K - "$u/status")"
    [ "$code" != "000" ] && { echo "$u"; return 0; }
  done
  echo "$first"
}
remote_label() {  # 表示用: local と global を並べる
  local l g; l="$(remote_get local)"; g="$(remote_get global)"
  [ -n "$l$g" ] || { remote_get url; return; }
  echo "ローカル ${l:-なし} / グローバル ${g:-なし}"
}
app_running() { pgrep -f "$APP_BIN" >/dev/null 2>&1; }

install_python_side() {
  mkdir -p "$DATA"
  if [ ! -x "$VENV/bin/python" ]; then
    local py; py="$(find_python 12)" || { err "Python 3.12 以上がありません → brew install python@3.13"; return 1; }
    say "Python 環境を作成中 ($py)"
    "$py" -m venv "$VENV" || { err "venv の作成に失敗"; return 1; }
  fi
  if ! "$VENV/bin/python" -c 'import SolixBLE, anker_solix_api' 2>/dev/null; then
    say "部品を導入中 (SolixBLE, anker-solix-api。git が必要: xcode-select --install)"
    "$VENV/bin/pip" install -q --upgrade pip -r "$SRC_DIR/requirements.txt" \
      || { err "部品の導入に失敗しました (git / ネットワークを確認)"; return 1; }
  fi
  cp "$SRC_DIR/anker_monitor.py" "$PY_DST"
  cp "$SRC_DIR/dashboard.html" "$DATA/dashboard.html"
  printf '{"python": "%s", "script": "%s"}\n' "$VENV/bin/python" "$PY_DST" > "$DATA/launch.json"
  ok "バックエンドとダッシュボードを反映: $DATA"
}

build_app() {
  xcrun -f swiftc >/dev/null 2>&1 || { err "swiftc がありません → xcode-select --install"; return 1; }
  say "メニューバーアプリをビルド中..."
  mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
  xcrun swiftc -O "$SRC_DIR/AnkerMonitor.swift" -o /tmp/AnkerMonitor.new \
      -framework AppKit -framework WebKit -framework UserNotifications || { err "Swift のビルドに失敗しました"; return 1; }
  cp "$SRC_DIR/Info.plist" "$APP/Contents/Info.plist"
  install -m 755 /tmp/AnkerMonitor.new "$APP_BIN" && rm -f /tmp/AnkerMonitor.new
  codesign --force --deep -s - "$APP" 2>/dev/null || warn "codesign に失敗 (起動できなければ再実行してください)"
  ok "アプリを作成: $APP"
}

cmd_start() {
  app_running && { ok "すでに起動しています"; return 0; }
  [ -d "$APP" ] || { err "アプリがありません → amon setup"; return 1; }
  open "$APP"
  local i
  if is_remote; then
    for i in 1 2 3 4 5; do app_running && { ok "起動しました (リモート表示: $(remote_label))"; return 0; }; sleep 1; done
    warn "アプリが起動しません"; return 1
  fi
  for i in 1 2 3 4 5 6 7 8; do backend_up && { ok "起動しました (メニューバーを見てください)"; return 0; }; sleep 1; done
  warn "バックエンドの応答待ちです。amon logs で様子を見てください"
}

cmd_stop() {
  if app_running; then
    osascript -e 'tell application "AnkerMonitor" to quit' >/dev/null 2>&1 || pkill -TERM -f "$APP_BIN"
    local i; for i in 1 2 3 4 5 6; do app_running || break; sleep 1; done
  fi
  # 手動で起動したバックエンドが残っていれば止める
  pkill -TERM -f "anker_monitor.py" 2>/dev/null
  sleep 1
  ok "停止しました"
}

cmd_setup() {
  say "セットアップ"
  install_python_side || return 1
  build_app || return 1
  cmd_start
  cat <<'EOF'

次のことが起きます:
  ・初回は macOS が「AnkerMonitor が Bluetooth を使おうとしています」と聞くので「許可」を押す
    (出なかった/拒否した場合: システム設定 > プライバシーとセキュリティ > Bluetooth)
  ・ポタ電の画面を点けて、スマホの Anker アプリは終了しておく
  ・メニューバーに電池アイコンと % が出ます。クリックでダッシュボード、右クリックでメニュー
EOF
}

cmd_deploy() {
  say "反映して再起動"
  if is_remote; then  # 見る側の Mac: バックエンドは使わないので、アプリだけ作り直す
    cmd_stop; build_app || return 1; cmd_start; return
  fi
  python3 -c 'import sys; compile(open(sys.argv[1], encoding="utf-8").read(), sys.argv[1], "exec")' \
      "$SRC_DIR/anker_monitor.py" || { err "anker_monitor.py に構文エラーがあります"; return 1; }
  cmd_stop
  install_python_side || return 1
  build_app || return 1
  cmd_start && cmd_url
}

# この Mac を開くアドレス (バックエンドの /api/this-mac と同じもの。ダッシュボードの「機器」タブ > この Mac にも出る)
cmd_url() {
  if is_remote; then say "リモート表示: $(remote_label)"; return 0; fi
  local j; j="$(curl -fsS --max-time 10 "http://localhost:$PORT/api/this-mac" 2>/dev/null)" \
    || { warn "バックエンドが応答しません (amon logs で様子を見てください)"; return 1; }
  echo "$j" | /usr/bin/python3 -c '
import json, sys
d = json.load(sys.stdin)
print("この Mac を開くアドレス:")
for a in d["addresses"]:
    print("  %-34s %s" % (a["url"], a["label"]))
if not d["lan"]:
    print("  (いまは LAN に公開していないので、開けるのは localhost だけです。ほかの端末からは amon lan on)")
'
}

# どこからでも amon と打てるようにする 1 行 (amon env >> ~/.zshrc でも足せる)
cmd_env() {
  echo '# amon (Anker Monitor)'
  echo 'export PATH="$HOME/.local/bin:$PATH"'
}

cmd_status() {
  if app_running; then ok "メニューバーアプリ: 起動中"; else warn "メニューバーアプリ: 停止"; fi
  if is_remote; then
    local url tok; url="$(remote_pick)"; tok="$(remote_get token)"
    say "リモート表示: $(remote_label)"
    say "使っている接続先: $url"
    printf 'header = "Authorization: Bearer %s"\n' "$tok" | curl -fsS --max-time 5 -K - "$url/status" | /usr/bin/python3 -c '
import json, sys
for d in json.load(sys.stdin)["devices"]:
    print("   %s [%s]  バッテリー %s%%  入力 %sW  出力 %sW" % (d.get("name") or d["id"], d.get("state"), d.get("battery"), d.get("power_in"), d.get("power_out")))
' 2>/dev/null || warn "応答なし (Tailscale / 記録している Mac / トークンを確認)"
    return 0
  fi
  if backend_up; then
    ok "バックエンド: 応答あり (http://localhost:$PORT)"
    curl -fsS "http://localhost:$PORT/status" | "$VENV/bin/python" -c '
import json, sys
for d in json.load(sys.stdin)["devices"]:
    print("   %s [%s]" % (d.get("name") or d["id"], d.get("state")))
    print("   バッテリー %s%%  入力 %sW  出力 %sW  %s" % (d.get("battery"), d.get("power_in"), d.get("power_out"), d.get("charging") or ""))
    if d.get("detail"): print("   ", d["detail"])
' 2>/dev/null
  else
    warn "バックエンド: 応答なし"
  fi
  [ -f "$AGENT" ] && ok "ログイン時の自動起動: 有効" || echo "   ログイン時の自動起動: 無効 (amon autostart on)"
}

cmd_lan() {
  case "${1:-}" in
    on)  mkdir -p "$DATA"; touch "$DATA/lan"; cmd_stop; cmd_start; lan_urls
         warn "初回は macOS が「python への受信接続を許可しますか」と聞くので「許可」を選んでください。同じ Wi-Fi の端末からだけ、見るだけで開けます" ;;
    off) rm -f "$DATA/lan"; cmd_stop; cmd_start; ok "LAN への公開をやめました (このMacからだけ)" ;;
    *)   if [ -f "$DATA/lan" ]; then ok "LAN 公開: オン"; lan_urls; else say "LAN 公開: オフ (amon lan on で有効)"; fi ;;
  esac
}

lan_urls() {
  local h ip
  h="$(scutil --get LocalHostName 2>/dev/null)"
  local q=""; [ -s "$TOKEN_FILE" ] && q="/?token=$(cat "$TOKEN_FILE")"
  [ -n "$h" ] && say "スマホ用 URL: http://$h.local:$PORT$q"
  for ip in $(ipconfig getifaddr en0 2>/dev/null) $(ipconfig getifaddr en1 2>/dev/null); do say "スマホ用 URL: http://$ip:$PORT$q"; done
  # Tailscale (VPN) が入っていれば、外出先用の URL も出す
  local ts; ts="$(command -v tailscale || ls /Applications/Tailscale.app/Contents/MacOS/Tailscale 2>/dev/null | head -1)"
  if [ -n "$ts" ]; then
    for ip in $("$ts" ip -4 2>/dev/null); do say "外出先用 URL (Tailscale): http://$ip:$PORT$q"; done
  fi
  [ -s "$TOKEN_FILE" ] || warn "トークンが未設定です。同じネットワークの誰でも読めます → amon token new"
}

cmd_token() {
  case "${1:-}" in
    new)
      mkdir -p "$DATA"
      ( umask 077; openssl rand -hex 24 > "$TOKEN_FILE" ) || { err "トークンを作れませんでした"; return 1; }
      ok "トークンを作りました (このMac以外からは、これが無いと読めません。再起動は不要)"
      echo "   $(cat "$TOKEN_FILE")"
      echo "   見る側の Mac で: amon remote http://<このMacの Tailscale IP>:$PORT $(cat "$TOKEN_FILE")"
      echo "   スマホなどのブラウザでは、最初に 1 回だけトークンを入れる画面が出ます (amon lan の URL なら入力不要)" ;;
    off) rm -f "$TOKEN_FILE"; ok "トークンをやめました (LAN 公開中は、同じネットワークの誰でも読めます)" ;;
    "")  if [ -s "$TOKEN_FILE" ]; then ok "トークン: $(cat "$TOKEN_FILE")"; else say "トークン: 未設定 (amon token new で作る)"; fi ;;
    *)   echo "使い方: amon token [new|off]"; return 1 ;;
  esac
}

# remote.json の 1 項目を書き換える (url だけの古い形はここで local / global に振り分ける)
remote_set() {
  mkdir -p "$DATA"
  ( umask 077; /usr/bin/python3 - "$REMOTE_FILE" "$1" "$2" <<'PY'
import json, re, sys
path, key, val = sys.argv[1:]
try: d = json.load(open(path))
except Exception: d = {}
old = d.pop("url", None)
if old and not d.get("local") and not d.get("global"):
    host = re.sub(r"^https?://", "", old).split(":")[0]
    d["global" if host.endswith(".ts.net") or host.startswith("100.") else "local"] = old
d[key] = val
json.dump({k: v for k, v in d.items() if v}, open(path, "w"))
PY
  ) || { err "設定を保存できませんでした"; return 1; }
  chmod 600 "$REMOTE_FILE"  # umask は新しく作るときしか効かない (前からあるファイルの権限は変わらない)
}

remote_check() {  # $1 = URL。届くかを見て結果を言う (保存はする)
  local tok code; tok="$(remote_get token)"
  say "接続を確認中: $1"
  code="$(printf 'header = "Authorization: Bearer %s"\n' "$tok" | curl -s -o /dev/null -w '%{http_code}' --max-time 5 -K - "$1/status")"
  case "$code" in
    200) ok "読めました" ;;
    401) warn "トークンが違います (記録している Mac で amon token を確認 → amon remote token <値>)" ;;
    403) warn "断られました (403)。記録している Mac で amon lan on にしてください" ;;
    *)   warn "いまは届きません (HTTP $code)。設定は保存します" ;;
  esac
}

remote_apply() {
  ok "リモート表示: $(remote_label)。この Mac では Bluetooth もバックエンドも動かしません ($REMOTE_FILE)"
  cmd_stop
  build_app || return 1  # 古いアプリにはリモート表示が無いので、毎回作り直す
  cmd_start
}

cmd_remote() {
  case "${1:-}" in
    off)
      rm -f "$REMOTE_FILE"; ok "リモート表示をやめました (この Mac で記録します)"
      cmd_stop; cmd_start ;;
    "")
      if is_remote; then ok "リモート表示: $(remote_label)"; say "使える接続先: $(remote_pick)"
      else say "リモート表示: オフ (この Mac で記録しています)"; fi ;;
    local|global)
      local key="$1" url; url="$(norm_url "${2:-}")"
      if [ -z "$url" ]; then remote_set "$key" "" && ok "$key を消しました"; else remote_set "$key" "$url" || return 1; remote_check "$url"; fi
      is_remote && [ -n "$(remote_urls)" ] && remote_apply ;;
    token)
      [ -n "${2:-}" ] || { err "使い方: amon remote token <トークン>"; return 1; }
      remote_set token "$2" || return 1
      local u; for u in $(remote_urls); do remote_check "$u"; done
      [ -n "$(remote_urls)" ] && remote_apply ;;
    *)
      # amon remote <URL> [トークン]: .ts.net と 100.x (Tailscale) はグローバル、それ以外はローカルとして覚える
      local url key; url="$(norm_url "$1")"
      case "${url#*://}" in *.ts.net*|100.*) key=global ;; *) key=local ;; esac
      [ -n "${2:-}" ] && { remote_set token "$2" || return 1; }
      remote_set "$key" "$url" || return 1
      say "$( [ $key = local ] && echo ローカル || echo グローバル ) として保存しました"
      remote_check "$url"
      remote_apply ;;
  esac
}

cmd_autostart() {
  local dom="gui/$(id -u)"
  case "${1:-}" in
    on)
      mkdir -p "$HOME/Library/LaunchAgents"
      cat > "$AGENT" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>/usr/bin/open</string><string>$APP</string></array>
  <key>RunAtLoad</key><true/>
</dict></plist>
EOF
      launchctl bootout "$dom/$LABEL" 2>/dev/null
      launchctl bootstrap "$dom" "$AGENT" 2>/dev/null || launchctl load "$AGENT" 2>/dev/null
      ok "ログイン時に自動起動します" ;;
    off)
      launchctl bootout "$dom/$LABEL" 2>/dev/null || launchctl unload "$AGENT" 2>/dev/null
      rm -f "$AGENT"
      ok "自動起動をやめました" ;;
    *) echo "使い方: amon autostart on|off"; return 1 ;;
  esac
}

cmd_link() {
  local dir="" d
  for d in /opt/homebrew/bin /usr/local/bin "$HOME/.local/bin"; do
    case ":$PATH:" in *":$d:"*) [ -d "$d" ] && [ -w "$d" ] && { dir="$d"; break; } ;; esac
  done
  if [ -z "$dir" ]; then
    dir="$HOME/.local/bin"; mkdir -p "$dir"
    local rc="$HOME/.zshrc"
    if ! grep -qs '\.local/bin' "$rc"; then
      printf '\n# amon (Anker Monitor)\nexport PATH="$HOME/.local/bin:$PATH"\n' >> "$rc"
      echo "PATH を $rc に追記しました。新しいターミナルを開くか: source ~/.zshrc"
    else
      echo "$rc に .local/bin の設定が既にあります (新しいターミナルで有効)"
    fi
  fi
  ln -sf "$SRC_DIR/amon" "$dir/amon" && echo "リンク作成: $dir/amon -> $SRC_DIR/amon"
  echo "どこからでも: amon restart / amon deploy / amon status"
}

cmd_cloud_setup() {
  mkdir -p "$DATA"
  local need=0
  if [ -x "$VENV/bin/python" ] && ! "$VENV/bin/python" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 12) else 1)' 2>/dev/null; then need=1; fi
  if [ ! -x "$VENV/bin/python" ] || [ "$need" = 1 ]; then
    local py; py="$(find_python 12)" || { err "Python 3.12 以上がありません → brew install python@3.13"; return 1; }
    [ "$need" = 1 ] && warn "いまの Python 環境は 3.12 未満なので作り直します"
    cmd_stop
    rm -rf "$VENV"
    say "Python 環境を作成中 ($py)"
    "$py" -m venv "$VENV" || { err "venv の作成に失敗"; return 1; }
  fi
  say "部品を導入中 (SolixBLE, anker-solix-api)"
  "$VENV/bin/pip" install -q --upgrade pip -r "$SRC_DIR/requirements.txt" \
    || { err "導入に失敗しました (git が必要です: xcode-select --install)"; return 1; }
  ok "導入しました"
  cmd_stop
  install_python_side && cmd_start
  echo "ダッシュボードの「機器」タブ > クラウド から Anker のメールアドレスとパスワードでログインしてください。"
}

# トークンを引数や画面に出さないよう、remote.json から読んで curl の設定 (標準入力) で渡す
cmd_get() {
  local path="${1:-}"
  [ -n "$path" ] || { err "使い方: amon get '/api/raw?hours=48'"; return 1; }
  case "$path" in /*) ;; *) path="/$path" ;; esac
  if is_remote; then
    local url tok; url="$(remote_pick)"; tok="$(remote_get token)"
    printf 'header = "Authorization: Bearer %s"\n' "$tok" | curl -fsS --max-time 60 -K - "$url$path"
  else
    curl -fsS --max-time 60 "http://localhost:$PORT$path"
  fi
}

usage() { sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
  setup)     cmd_setup ;;
  deploy|up|r) cmd_deploy ;;
  start)     cmd_start ;;
  stop)      cmd_stop ;;
  restart)   cmd_stop; cmd_start ;;
  status)    cmd_status ;;
  open)      open "http://localhost:$PORT" ;;
  logs)      tail -n 50 -f "$DATA/backend.log" ;;
  run)       shift; install_python_side && exec "$VENV/bin/python" "$PY_DST" "$@" ;;
  cloud-setup) cmd_cloud_setup ;;
  scan-all)  install_python_side && exec "$VENV/bin/python" "$PY_DST" --scan-all ;;
  demo)      install_python_side && exec "$VENV/bin/python" "$PY_DST" --demo ;;
  link)      cmd_link ;;
  lan)       shift; cmd_lan "${1:-}" ;;
  token)     shift; cmd_token "${1:-}" ;;
  remote)    shift; cmd_remote "$@" ;;
  get)       shift; cmd_get "${1:-}" ;;
  url)       cmd_url ;;
  env)       cmd_env ;;
  autostart) shift; cmd_autostart "${1:-}" ;;
  *)         usage ;;
esac
